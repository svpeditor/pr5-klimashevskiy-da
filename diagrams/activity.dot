digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.3, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Получить строку часов" ,shape=parallelogram,fillcolor="#E4DFEC",color="#7030A0"];
n0 [label="Строка пустая" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n2 [label="Разделить строку на элементы: split(\";\", -1)" ];
n3 [label="Ровно пять значений" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n4 [label="A1 Цикл for по элементам, позиция i + 1:\nэлемент - целое число (-?\\d+), Integer.parseInt,\nзначение от 0 до 16" ];
n5 [label="Элемент корректен" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n5b [label="Есть еще элементы" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n6 [label="Вычислить сумму (цикл по массиву), среднее = сумма / 5,\nдни с переработкой (больше 10 часов),\nнедельную переработку max(0, сумма - 40)" ];
n7 [label="A2 Сформировать отчет: всего часов, среднее с одним знаком,\nдней с переработкой, недельная переработка" ];
n8 [label="Сформировать сообщение об ошибке:\nпустая строка, число значений с номером позиции\nили позиция и неверное значение" ];
start -> n1;
n1 -> n0;
n0 -> n8 [label="да"];
n0 -> n2 [label="нет"];
n2 -> n3;
n3 -> n4 [label="да"];
n3 -> n8 [label="нет"];
n4 -> n5;
n5 -> n5b [label="да"];
n5 -> n8 [label="нет"];
n5b -> n4 [label="да"];
n5b -> n6 [label="нет"];
n6 -> n7;
n7 -> end;
n8 -> end;
}
